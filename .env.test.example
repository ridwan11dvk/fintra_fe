# Node environment (typically 'test')
NODE_ENV=dev

# Base URL for the application
BASE_URL=http://localhost:5173

# Browser mode: 'true' for headless, 'false' for visible browser
HEADLESS=false

SCREENSHOT_MODE=off
VIDEO_MODE=off
PARALLEL=false

# Browser to use: 'chrome' or 'firefox'
BROWSER=chrome

# Implicit wait timeout in milliseconds (default wait for element to appear)
IMPLICIT_WAIT=10000

# Explicit wait timeout in milliseconds (max wait for specific conditions)
EXPLICIT_WAIT=15000

# Test timeout in milliseconds (mocha test timeout)
TEST_TIMEOUT=30000

# Test retry count (number of times to retry failed tests)
TEST_RETRIES=1

# Slow down Playwright actions by the specified amount of milliseconds (useful for debugging)
SLOW_MO=1000

MAX_WORKERS=90%

# Test user credentials (Internal login)
TEST_USER_EMAIL=admin@fintra.test
TEST_USER_PASSWORD=password123

# Test user credentials (External login)
TEST_EXTERNAL_USER_EMAIL=external@fintra.test
TEST_EXTERNAL_USER_PASSWORD=password123
