VITE_NODE_ENV = "development"
VITE_APP_NAME = "Finalink"
VITE_ESA_URL = "https://esa-alpha.kai.id"
VITE_API_BASE_URL = "http://localhost:3000/api"
# Local Payable BE profile: local-bypass on http://localhost:8081
VITE_PAYABLE_API_BASE_URL = "http://localhost:8081"
VITE_PROCUREMENT_CENTRAL_COST_CENTER = "0010103000"
VITE_PROCUREMENT_CENTRAL_BA = "A010"

# Module Federation remote entry URLs (fallback: http://localhost:300{1,2}/remoteEntry.js)
VITE_PAYABLE_ENTRY_URL = "http://localhost:3001/remoteEntry.js"
VITE_TAX_ENTRY_URL = "http://localhost:3002/remoteEntry.js"

# Per-module API base URLs, resolved by MainLayout from the first path
# segment via AppConfig.customApiUrls (e.g. /tax/* -> VITE_TAX_API_BASE_URL)
# VITE_TAX_API_BASE_URL = "https://api-tax-railfinance-alpha.kai.id/api"
# VITE_PAYABLE_API_BASE_URL = "https://api-payable-railfinance-alpha.kai.id/api"

#Push Notification (VAPID key - base64url encoded, generated by backend)
VITE_VAPID_PUBLIC_KEY=

